GROQ_API_KEY=
GEMINI_API_KEY=

# Comma-separated allowed browser origins for CORS. Local dev default is
# http://localhost:3000 (config.py) -- in production set this to the real
# Vercel domain(s), e.g.:
# CORS_ORIGINS=https://uniintel.vercel.app,https://uniintel-git-main-yourteam.vercel.app
CORS_ORIGINS=

# SQLite file path. Defaults to <repo_root>/data/uniintel.db if unset. On
# Railway/Render set this to a path under an attached persistent
# Volume/Disk (e.g. /data/uniintel.db) -- the default filesystem is
# ephemeral and is wiped on every redeploy. See persistence/db.py.
DB_PATH=
